# zero-human environment

# --- Model provider (optional for the $0 simulated demo) ---
# Leave unset to run everything with the ScriptedAdapter (zero token cost).
# Set a real key to use the AnthropicAdapter for live runs (guarded by hard budget caps).
ANTHROPIC_API_KEY=

# Default model for hired Anthropic agents (see src/core/pricing.ts for the price book)
ZH_DEFAULT_MODEL=claude-opus-4-8

# --- Free-tier infra (V1 — not required for the in-memory demo/tests) ---
# Neon serverless Postgres (event log, budget CAS, pgvector)
DATABASE_URL=

# Inngest (durable agent turn loop on Vercel)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
