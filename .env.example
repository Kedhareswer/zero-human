# zero-human environment

# --- Model provider (optional for the $0 simulated demo) ---
# Leave unset to run everything with the ScriptedAdapter (zero token cost).
# Set a real key to use the AnthropicAdapter for live runs (guarded by hard budget caps).
ANTHROPIC_API_KEY=

# Default model for hired Anthropic agents (see src/core/pricing.ts for the price book)
ZH_DEFAULT_MODEL=claude-opus-4-8

# --- Free-tier infra (production path; not required for the in-memory demo/tests) ---
# Neon serverless Postgres — set this and the kernel store factory switches from
# the in-memory store to PgStore (event log + atomic budget CAS). Apply
# src/db/migrations/0000_init.sql first.
DATABASE_URL=

# Inngest (durable agent turn loop on Vercel — the execution plane)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Governor guard for mutation routes (/api/review). If set, callers must send it
# as the x-governor-token header. Leave unset for open local/demo use.
ZH_GOVERNOR_TOKEN=
